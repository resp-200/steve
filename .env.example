# Copy this file to .env and fill in real values.
# Any OpenAI- or Anthropic-compatible endpoint works.

# --- Anthropic Messages style gateway (current setup) ---
LLM_API_KEY="sk_xxxx"
LLM_MODEL_ID="your-model-id"
LLM_BASE_URL="https://your-gateway.example.com/anthropic"

# --- OpenAI style gateway (alternative) ---
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_BASE_URL="https://your-gateway.example.com/codex/v1"
# LLM_API="openai-completions"     # or "openai-responses" for gateways that only expose /responses

# Optional
# LLM_API="anthropic-messages"     # normally auto-detected from LLM_BASE_URL
# LLM_AUTH_STYLE="auto"            # auto | bearer | api-key
# LLM_PROVIDER="myprovider"        # provider id reported to pi (default: "custom")
# LLM_REASONING="false"            # "true" enables reasoning/thinking output
# LLM_CONTEXT_WINDOW="128000"
# LLM_MAX_TOKENS="8192"
# LLM_SYSTEM_PROMPT="You are a terse assistant."
