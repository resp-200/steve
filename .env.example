# Copy this file to .steve/.env and fill in real values.
#
#   mkdir -p .steve && cp .env.example .steve/.env
#
# The whole .steve/ directory is gitignored: local config and secrets belong there,
# never in the repository. Only `.steve/.env` is read — a plain `.env` is ignored.
#
# Files are read lowest priority first, so a later one overrides an earlier one,
# and a real environment variable always wins over every file:
#
#   <project>/.steve/.env           ← the project steve was installed in
#   ~/.steve/.env                   global, every project
#   $PWD/.steve/.env                ← the directory you run in (highest priority)
#
# Any OpenAI- or Anthropic-compatible endpoint works.

# --- Anthropic Messages style gateway (current setup) ---
LLM_API_KEY="sk_xxxx"
LLM_MODEL_ID="deepseek"
LLM_BASE_URL="https://xxxx"

# --- OpenAI style gateway (alternative) ---
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_BASE_URL="https://your-gateway.example.com/codex/v1"
# LLM_API="openai-completions"     # or "openai-responses" for gateways that only expose /responses

# Optional
# LLM_API="anthropic-messages"     # normally auto-detected from LLM_BASE_URL
# LLM_AUTH_STYLE="auto"            # auto | bearer | api-key
# LLM_PROVIDER="myprovider"        # provider id reported to pi (default: "custom")
# LLM_REASONING="false"            # "true" enables reasoning/thinking output
# LLM_CONTEXT_WINDOW="128000"
# LLM_MAX_TOKENS="8192"
# LLM_SYSTEM_PROMPT="You are a terse assistant."

# Secrets used by MCP servers declared in .steve/mcp.json or in a plugin
# (mcp.json does not interpolate ${...}: read the variable from a plugin instead).
# AMAP_MAPS_API_KEY=""
