# Copy this file to ~/.steve/.env and fill in real values.
#
#   mkdir -p ~/.steve && cp .env.example ~/.steve/.env
#
# ~/.steve/ is the one global state directory (created on first run): credentials,
# admin.json, watch.json, mcp.json, extensions/, streams/, sessions/ and logs/ all
# live there, so every entry point reads the same config from any cwd.
#
# Only `~/.steve/.env` is read — a plain `.env`, an install-directory `.env` and a
# project `<cwd>/.steve/.env` are all ignored now. A real environment variable
# always wins over the file. `STEVE_HOME` points the whole directory elsewhere.
#
# Any OpenAI- or Anthropic-compatible endpoint works.

# --- Anthropic Messages style gateway (current setup) ---
LLM_API_KEY="sk_xxxx"
LLM_MODEL_ID="deepseek"
LLM_BASE_URL="https://xxxx"

# --- OpenAI style gateway (alternative) ---
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_BASE_URL="https://your-gateway.example.com/codex/v1"
# LLM_API="openai-completions"     # or "openai-responses" for gateways that only expose /responses

# Optional
# LLM_API="anthropic-messages"     # normally auto-detected from LLM_BASE_URL
# LLM_AUTH_STYLE="auto"            # auto | bearer | api-key
# LLM_PROVIDER="myprovider"        # provider id reported to pi (default: "custom")
# LLM_REASONING="false"            # "true" enables reasoning/thinking output
# LLM_CONTEXT_WINDOW="128000"
# LLM_MAX_TOKENS="8192"
# LLM_SYSTEM_PROMPT="You are a terse assistant."

# Secrets used by MCP servers declared in ~/.steve/mcp.json or in a plugin
# (mcp.json does not interpolate ${...}: read the variable from a plugin instead).
# AMAP_MAPS_API_KEY=""

# --- Web search (web_search tool) ---
# web_fetch works with no key. web_search is registered only when one of these
# keys is set; WEB_SEARCH_PROVIDER picks one explicitly when several are.
# WEB_SEARCH_PROVIDER="tavily"     # tavily | exa | brave (default: first with a key)
# TAVILY_API_KEY="tvly-xxxxxxxx"   # https://app.tavily.com  — returns a summary + sources
# EXA_API_KEY="xxxxxxxx"           # https://dashboard.exa.ai — semantic search, page text
# BRAVE_API_KEY="xxxxxxxx"         # https://brave.com/search/api — cheapest per call

# --- Feishu (Lark) bot for `steve-serve` ---
# Create a 自建应用 with 机器人 capability and subscribe to "接收消息 v2.0
# (im.message.receive_v1)". Event transport defaults to the long connection
# (WebSocket): the process dials out, so no public callback URL is needed.
# Choose HTTP callback instead (FEISHU_MODE=http) only if you must expose
# https://<your-host>/feishu/events; it needs the verification token.
# https://open.feishu.cn/document/server-docs/im-v1/message/events/receive
# FEISHU_APP_ID="cli_xxxxxxxxxxxxxxxx"
# FEISHU_APP_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# FEISHU_MODE="ws"                 # ws (default, long connection) | http (callback)
# FEISHU_VERIFICATION_TOKEN=""     # only for FEISHU_MODE=http
# FEISHU_ENCRYPT_KEY=""            # only for HTTP mode with 加密策略 enabled
# FEISHU_API_BASE=""               # tests only; defaults to https://open.feishu.cn

# --- WeChat (ClawBot / iLink) for `steve-serve` ---
# No configuration here: run `steve-wechat` once and scan the QR code with the
# WeChat account the bot should serve. The login is stored in ~/.steve/wechat.json
# and `steve-serve` picks it up on the next start (--no-wechat turns it off).
# The agent has shell access, so by default only the account that scanned the code
# is answered; anyone else is ignored.
# STEVE_WECHAT_ALLOW=""            # extra user ids allowed to talk to the bot, comma separated
